{
  "name": "mydocxtor",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side PDF & image toolkit. All processing happens in the browser; no file ever leaves the device.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "tsx tests/fixtures/generate.ts",
    "ci": "bun run lint && bun run type-check && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "comlink": "4.4.2",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.1.1",
    "dompurify": "^3.2.4",
    "fflate": "0.8.2",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "next": "15.5.4",
    "next-themes": "0.4.6",
    "node-forge": "1.3.1",
    "pdf-lib": "1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "4.10.38",
    "pixelmatch": "^6.0.0",
    "pptxgenjs": "^3.12.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "2.6.0",

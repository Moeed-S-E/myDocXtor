  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.1",
    "@types/node-forge": "1.3.11",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.19.0",
